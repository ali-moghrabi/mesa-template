    "faqs": [
      {
        "question": "Do I need a reservation?",
        "answer": "Walk-ins are welcome, but we recommend booking, especially Thursday to Saturday."
      },
      {
        "question": "Do you have vegetarian and vegan options?",
        "answer": "Yes. Dishes are labeled on the menu and our team can adapt many others."
      },
      {
        "question": "Can I host a private event?",
        "answer": "Our private room seats up to 24 guests. Send us a message from the contact page."
      },
      {
        "question": "Is the restaurant wheelchair accessible?",
        "answer": "Yes, the dining room, terrace and restrooms are fully step-free."
      }
    ],

    "events": [
      {
        "id": "e1",
        "title": "Jazz Fridays",
        "date": "Every Friday",
        "time": "20:00",
        "description": "Live jazz trio with a special three-course menu.",
        "image": "images/events/jazz.jpg",
        "cta": { "label": "Reserve", "href": "/reservations" }
      },
      {
        "id": "e2",
